# Local SQLite (default for `cargo run`)
DATABASE_URL=sqlite:mortgage.db
# DB_MODE=local

HOST=127.0.0.1
PORT=3000

# Directory served at /static (CSS/JS). Defaults to <crate>/static when unset.
# STATIC_DIR=./static

# Cookie flags — keep Secure=false for local HTTP; set true behind HTTPS in production
SESSION_SECURE=false
# Lax | Strict | None (None requires SESSION_SECURE=true)
SESSION_SAME_SITE=Lax

# Optional: override "today" for schedule/calendar/payments (YYYY-MM-DD)
# CURRENT_DATE=2026-03-15

# Dev-only account seeding. Leave unset/false in production.
# ALLOW_DEV_SEED_USERS=true
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=choose-a-strong-local-password
# TEST_USER_2_EMAIL=demo@example.com
# TEST_USER_2_PASSWORD=choose-a-strong-local-password

# Optional: SQL-over-HTTP backend (used by some hosted deployments; not needed locally)
# DB_MODE=sql_rpc
# DB_RPC_URL=https://example.com
# INTERNAL_DB_SECRET=generate-a-long-random-string
