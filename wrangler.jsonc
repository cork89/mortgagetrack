/**
 * Cloudflare Worker + Container config for Homeabell.
 *
 * Setup:
 *   1. npm install
 *   2. npx wrangler d1 create homeabell   # paste database_id below
 *   3. npx wrangler secret put INTERNAL_DB_SECRET
 *   4. Set vars.DB_RPC_URL to the public origin (custom domain)
 *   5. npx wrangler d1 migrations apply homeabell --remote
 *   6. npx wrangler deploy / cf deploy
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "homeabell",
	"main": "worker/src/index.ts",
	"account_id": "339b1f77882b562b72a6376101d67b98",
	"compatibility_date": "2026-04-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "homeabell.com",
			"custom_domain": true
		},
		{
			"pattern": "www.homeabell.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"DB_RPC_URL": "https://homeabell.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "homeabell",
			"database_id": "b25b9dad-830b-42ca-994d-fd98a2fe3ae9",
			"migrations_dir": "migrations"
		}
	],
	"containers": [
		{
			"class_name": "HomeabellContainer",
			"image": "./Dockerfile",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "HOMEABELL",
				"class_name": "HomeabellContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"HomeabellContainer"
			]
		}
	]
}
